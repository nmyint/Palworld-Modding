{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PwTools: Test",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-Command",
                "Invoke-Pester -Path './10_Scripts/Tests' -EnableExit"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Validate Profiles",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-Command",
                "Import-Module './10_Scripts/Modules/PalworldModding.psd1' -Force; $results = Get-PwProfiles | ForEach-Object { Test-PwProfile -Name $_.Name }; $results | Format-List; if ($results | Where-Object { -not $_.IsValid }) { exit 1 }"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Preview Deployment",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-Command",
                "Import-Module './10_Scripts/Modules/PalworldModding.psd1' -Force; $plan = Get-PwDeploymentPlan; $plan | Format-List; $plan.Files | Format-Table Action, RelativePath, DestinationPath"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        }
    ]
}
