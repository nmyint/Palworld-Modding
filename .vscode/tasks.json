                "./10_Scripts/Tasks/Test-Profiles.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Validate Environment",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Test-Environment.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Inspect Mod Archive",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Inspect-ModArchive.ps1",
                "-Path",
                "${input:modArchivePath}"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Preview Deployment",
            "type": "shell",
