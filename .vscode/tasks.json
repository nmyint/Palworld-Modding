    "inputs": [
        {
            "id": "modArchivePath",
            "type": "promptString",
            "description": "Full path to a mod ZIP or 7z archive"
        },
        {
            "id": "validatedModName",
            "type": "promptString",
            "description": "Validated mod name"
        },
        {
            "id": "validatedModVersion",
            "type": "promptString",
            "description": "Validated mod version"
        },
        {
            "id": "validationNotes",
            "type": "promptString",
            "description": "Optional in-game validation notes"
        },
        {
            "id": "backupPath",
            "type": "promptString",
            "description": "Deployment backup folder or manifest.json path"
        },
        {
            "id": "workshopBackupDestination",
            "type": "promptString",
            "description": "External backup folder (blank uses Workshop.json)"
        }
    ]
}
