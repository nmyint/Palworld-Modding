            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Show-InstallationInventory.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Deployment History",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Show-DeploymentHistory.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Diagnostics",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Show-WorkshopDiagnostics.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
