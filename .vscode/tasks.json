{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PwTools: Test",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Test-Workshop.ps1"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Validate Profiles",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Test-Profiles.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Validate Environment",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Test-Environment.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Inspect Mod Archive",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Inspect-ModArchive.ps1",
                "-Path",
                "${input:modArchivePath}"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Preview Deployment",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Show-DeploymentPreview.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "PwTools: Complete Mod Validation",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "./10_Scripts/Tasks/Complete-ModValidation.ps1",
                "-Name",
                "${input:validatedModName}",
                "-Version",
                "${input:validatedModVersion}",
                "-Notes",
                "${input:validationNotes}"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        }
    ],
    "inputs": [
        {
            "id": "modArchivePath",
            "type": "promptString",
            "description": "Full path to a mod ZIP or 7z archive"
        },
        {
            "id": "validatedModName",
            "type": "promptString",
            "description": "Validated mod name"
        },
        {
            "id": "validatedModVersion",
            "type": "promptString",
            "description": "Validated mod version"
        },
        {
            "id": "validationNotes",
            "type": "promptString",
            "description": "Optional in-game validation notes"
        }
    ]
}
