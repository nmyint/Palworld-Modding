{
    "SchemaVersion": "1.0",
    "Workshop": {
        "Name": "Palworld Modding Workshop",
        "Version": "0.3.6",
        "Owner": "Noel",
        "Created": "2026-07-28",
        "Description": "Personal Palworld mod development and deployment workshop."
    },
    "Paths": {
        "Root": ".",
        "Archives": "01_Archives",
        "Staging": "02_Staging",
        "ModLibrary": "03_Mod_Library",
        "Projects": "04_Projects",
        "Deployment": "05_Deployment",
        "CurrentInstallation": "06_Current_Installation",
        "Testing": "07_Testing",
        "Tools": "08_Tools",
        "Logs": "09_Logs",
        "Scripts": "10_Scripts",
        "Utilities": "11_Utilities",
        "Research": "12_Research",
        "Backups": "13_Backups",
        "Templates": "14_Templates",
        "Sandbox": "15_Sandbox",
        "Profiles": "16_Profiles"
    },
    "Deployment": {
        "ActiveProfile": "Stable"
    },
    "Backup": {
        "DestinationRoot": "",
        "RetentionCount": 5
    },
    "Tools": {
        "PowerShell": {
            "RequiredVersion": "7.6.4"
        },
        "Git": {
            "Required": true
        },
        "SevenZip": {
            "Enabled": true,
            "Path": "%ProgramFiles%\\7-Zip\\7z.exe"
        },
        "UE4SS": {
            "Version": ""
        },
        "WinMerge": {
            "Enabled": true
        }
    },
    "Git": {
        "DefaultBranch": "main",
        "CommitConvention": "Conventional"
    },
    "Preferences": {
        "AutoArchiveLogs": true,
        "CreateBackupsBeforeDeployment": true,
        "VerboseOutput": false,
        "ConfirmDestructiveOperations": true
    }
}
